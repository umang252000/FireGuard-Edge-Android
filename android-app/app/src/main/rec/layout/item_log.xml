<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="8dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView android:id="@+id/tvLogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvLogTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#666"/>
</LinearLayout>